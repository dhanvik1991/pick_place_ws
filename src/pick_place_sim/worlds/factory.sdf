<?xml version="1.0" ?>
<!--
  Factory cell, step 1: conveyor belt + place table.
  Boxes travel along +X. The robot (spawned from URDF) stands at (0, -0.55) on a pedestal.
  Overhead camera looks straight down at the pick zone (x = 0.3).

  Belt speed (m/s):  ROS topic /conveyor/speed  (std_msgs/Float64)
  Boxes ride the belt via a VelocityControl plugin in each box (see box_spawner.py);
  the Fortress TrackController did not move objects on this setup.
-->
<sdf version="1.8">
  <world name="factory">
    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <!-- Needed later for the overhead camera -->
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== Conveyor belt (static surface; boxes are driven by box_spawner.py) ===== -->
    <model name="conveyor">
      <static>true</static>
      <pose>0 0 0.70 0 0 0</pose>
      <link name="base_link">
        <collision name="belt_collision">
          <geometry><box><size>3.0 0.4 0.05</size></box></geometry>
          <surface>
            <friction>
              <!-- frictionless: boxes are driven by their VelocityControl plugin, and belt
                   friction would drag them below the commanded speed -->
              <ode><mu>0.0</mu><mu2>0.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="belt_visual">
          <geometry><box><size>3.0 0.4 0.05</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <visual name="roller_in">
          <pose>-1.5 0 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.42</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient></material>
        </visual>
        <visual name="roller_out">
          <pose>1.5 0 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.42</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Conveyor frame / legs (separate model so they don't act as belt surface) -->
    <model name="conveyor_frame">
      <static>true</static>
      <link name="link">
        <visual name="leg_1"><pose>-1.3 0.15 0.3375 0 0 0</pose><geometry><box><size>0.05 0.05 0.675</size></box></geometry><material><ambient>0.3 0.35 0.4 1</ambient></material></visual>
        <visual name="leg_2"><pose>-1.3 -0.15 0.3375 0 0 0</pose><geometry><box><size>0.05 0.05 0.675</size></box></geometry><material><ambient>0.3 0.35 0.4 1</ambient></material></visual>
        <visual name="leg_3"><pose>1.3 0.15 0.3375 0 0 0</pose><geometry><box><size>0.05 0.05 0.675</size></box></geometry><material><ambient>0.3 0.35 0.4 1</ambient></material></visual>
        <visual name="leg_4"><pose>1.3 -0.15 0.3375 0 0 0</pose><geometry><box><size>0.05 0.05 0.675</size></box></geometry><material><ambient>0.3 0.35 0.4 1</ambient></material></visual>
        <collision name="leg_1c"><pose>-1.3 0.15 0.3375 0 0 0</pose><geometry><box><size>0.05 0.05 0.675</size></box></geometry></collision>
        <collision name="leg_2c"><pose>-1.3 -0.15 0.3375 0 0 0</pose><geometry><box><size>0.05 0.05 0.675</size></box></geometry></collision>
        <collision name="leg_3c"><pose>1.3 0.15 0.3375 0 0 0</pose><geometry><box><size>0.05 0.05 0.675</size></box></geometry></collision>
        <collision name="leg_4c"><pose>1.3 -0.15 0.3375 0 0 0</pose><geometry><box><size>0.05 0.05 0.675</size></box></geometry></collision>
      </link>
    </model>

    <!-- ===== Place table (designated drop area beside the conveyor) ===== -->
    <model name="place_table">
      <static>true</static>
      <pose>0.45 -0.75 0 0 0 0</pose>
      <link name="link">
        <collision name="top_c"><pose>0 0 0.5 0 0 0</pose><geometry><box><size>0.5 0.4 0.04</size></box></geometry></collision>
        <visual name="top_v"><pose>0 0 0.5 0 0 0</pose><geometry><box><size>0.5 0.4 0.04</size></box></geometry><material><ambient>0.1 0.4 0.15 1</ambient><diffuse>0.1 0.5 0.2 1</diffuse></material></visual>
        <collision name="base_c"><pose>0 0 0.24 0 0 0</pose><geometry><box><size>0.4 0.3 0.48</size></box></geometry></collision>
        <visual name="base_v"><pose>0 0 0.24 0 0 0</pose><geometry><box><size>0.4 0.3 0.48</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
      </link>
    </model>

    <!-- Pick-zone marker on the belt (visual only, white so vision ignores it) -->
    <model name="pick_zone_marker">
      <static>true</static>
      <pose>0.3 0 0.726 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.2 0.42 0.001</size></box></geometry>
          <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== Overhead camera (fixed, 2.0 m above floor, looking straight down) ===== -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>0.3 0 2.0 0 1.5708 0</pose>
      <link name="link">
        <visual name="body"><geometry><box><size>0.05 0.08 0.05</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>5</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>camera/image</topic>
        </sensor>
      </link>
    </model>

    <gui fullscreen="0">
      <plugin filename="GzScene3D" name="3D View">
        <ignition-gui><title>3D View</title><property type="bool" key="showTitleBar">false</property><property type="string" key="state">docked</property></ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.85 0.9</background_color>
        <camera_pose>2.2 -2.6 2.0 0 0.45 2.3</camera_pose>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <ignition-gui><title>World control</title><property type="bool" key="showTitleBar">false</property><property type="bool" key="resizable">false</property><property type="double" key="height">72</property><property type="double" key="width">121</property><property type="double" key="z">1</property><property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors>
        </ignition-gui>
        <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <ignition-gui><title>World stats</title><property type="bool" key="showTitleBar">false</property><property type="bool" key="resizable">false</property><property type="double" key="height">110</property><property type="double" key="width">290</property><property type="double" key="z">1</property><property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="right" target="right"/><line own="bottom" target="bottom"/></anchors>
        </ignition-gui>
        <sim_time>true</sim_time><real_time>true</real_time><real_time_factor>true</real_time_factor>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree"/>
    </gui>
  </world>
</sdf>

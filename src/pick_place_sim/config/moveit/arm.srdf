<?xml version="1.0"?>
<robot name="arm">
  <group name="arm">
    <chain base_link="base_link" tip_link="tcp"/>
  </group>
  <group name="gripper">
    <joint name="finger_left_joint"/>
    <joint name="finger_right_joint"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="joint1" value="2.07"/>
    <joint name="joint2" value="-0.2"/>
    <joint name="joint3" value="1.6"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="1.74"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <end_effector name="hand" parent_link="tcp" group="gripper" parent_group="arm"/>

  <!-- adjacent / never-colliding pairs -->
  <disable_collisions link1="pedestal" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="pedestal" link2="link1" reason="Never"/>
  <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="link2" reason="Never"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link5" reason="Never"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link6" reason="Never"/>
  <disable_collisions link1="link6" link2="gripper_base" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="gripper_base" reason="Never"/>
  <disable_collisions link1="link4" link2="gripper_base" reason="Never"/>
  <disable_collisions link1="gripper_base" link2="finger_left" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="finger_right" reason="Adjacent"/>
  <disable_collisions link1="finger_left" link2="finger_right" reason="Never"/>
  <disable_collisions link1="link6" link2="finger_left" reason="Never"/>
  <disable_collisions link1="link6" link2="finger_right" reason="Never"/>
  <disable_collisions link1="link5" link2="finger_left" reason="Never"/>
  <disable_collisions link1="link5" link2="finger_right" reason="Never"/>
</robot>
